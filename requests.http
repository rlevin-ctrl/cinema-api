@baseUrl = http://localhost:3000

### ---------------------------------------------------------------
### 1. Фільми
### ---------------------------------------------------------------

# @name createFilm
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Дюна: Частина друга",
  "durationMinutes": 166,
  "releaseYear": 2024
}

### Список фільмів
GET {{baseUrl}}/films

### Один фільм
GET {{baseUrl}}/films/{{createFilm.response.body.id}}

### Оновлення фільму
PATCH {{baseUrl}}/films/{{createFilm.response.body.id}}
Content-Type: application/json

{
  "durationMinutes": 167
}

### ---------------------------------------------------------------
### 2. Зали
### ---------------------------------------------------------------

# @name createHall
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Червона зала",
  "rows": 5,
  "seatsPerRow": 8
}

### Список залів
GET {{baseUrl}}/halls

### Зал з переліком місць
GET {{baseUrl}}/halls/{{createHall.response.body.id}}

### ---------------------------------------------------------------
### 3. Сеанси
### ---------------------------------------------------------------

# @name createShowing
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2027-01-15T18:30:00.000Z",
  "price": 15000
}

### Пагінація: перша сторінка по 2 записи
GET {{baseUrl}}/showings?page=1&limit=2&sort=asc

### Фільтр за фільмом
GET {{baseUrl}}/showings?filmId={{createFilm.response.body.id}}

### Фільтр за залом
GET {{baseUrl}}/showings?hallId={{createHall.response.body.id}}

### Фільтр за датою
GET {{baseUrl}}/showings?date=2027-01-15

### Сортування за спаданням
GET {{baseUrl}}/showings?sort=desc&limit=10

### Один сеанс
GET {{baseUrl}}/showings/{{createShowing.response.body.id}}

### Місця залу з ознакою зайнятості
GET {{baseUrl}}/showings/{{createShowing.response.body.id}}/seats

### ---------------------------------------------------------------
### 4. Бронювання
### ---------------------------------------------------------------

# @name createBooking
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 1 },
    { "row": 1, "seat": 2 }
  ]
}

### Усі бронювання
GET {{baseUrl}}/bookings

### Бронювання конкретного сеансу
GET {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings

### Скасування бронювання
DELETE {{baseUrl}}/bookings/{{createBooking.response.body.id}}

### ---------------------------------------------------------------
### 5. Помилки
### ---------------------------------------------------------------

### 409 — місце вже заброньоване
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [ { "row": 1, "seat": 1 } ]
}

### 400 — місця немає в залі
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [ { "row": 99, "seat": 1 } ]
}

### 400 — те саме місце двічі в одному запиті
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 2, "seat": 1 },
    { "row": 2, "seat": 1 }
  ]
}

### 400 — порожній масив місць
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": []
}

### 400 — некоректний UUID
GET {{baseUrl}}/showings/not-a-uuid

### 404 — неіснуючий сеанс
GET {{baseUrl}}/showings/00000000-0000-4000-8000-000000000000

### 400 — сеанс у минулому
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2020-01-01T10:00:00.000Z",
  "price": 15000
}

### 409 — фільм використовується в сеансах
DELETE {{baseUrl}}/films/{{createFilm.response.body.id}}

### 409 — зал використовується в сеансах
DELETE {{baseUrl}}/halls/{{createHall.response.body.id}}

### 409 — зал з такою назвою вже існує
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Червона зала",
  "rows": 3,
  "seatsPerRow": 3
}

### 400 — некоректний ліміт пагінації
GET {{baseUrl}}/showings?limit=500

### 400 — page не ціле число
GET {{baseUrl}}/showings?page=abc

### 400 — limit менше 1
GET {{baseUrl}}/showings?limit=0

### 400 — неправильний формат дати
GET {{baseUrl}}/showings?date=15-01-2027

### 400 — неприпустиме значення sort
GET {{baseUrl}}/showings?sort=up

### 400 — row не ціле число
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [ { "row": "перший", "seat": 1 } ]
}

### 404 — бронювання на неіснуючий сеанс
POST {{baseUrl}}/showings/00000000-0000-4000-8000-000000000000/bookings
Content-Type: application/json

{
  "seats": [ { "row": 1, "seat": 1 } ]
}
