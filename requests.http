@baseUrl = http://localhost:3000

### 1. Створити фільм
# @name createFilm
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Дюна: Частина друга",
  "durationMinutes": 166,
  "releaseYear": 2024
}

### 1a. Помилка 400: відсутнє поле
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Без року"
}

### 1b. Помилка 400: неправильний тип поля
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Тип",
  "durationMinutes": "багато",
  "releaseYear": 2020
}

### 2. Отримати всі фільми
GET {{baseUrl}}/films

### 3. Отримати фільм за id
GET {{baseUrl}}/films/{{createFilm.response.body.id}}

### 3a. Помилка 404: фільму не існує
GET {{baseUrl}}/films/00000000-0000-4000-8000-000000000000

### 3b. Помилка 400: id не є UUID
GET {{baseUrl}}/films/42

### 4. Оновити фільм
PATCH {{baseUrl}}/films/{{createFilm.response.body.id}}
Content-Type: application/json

{
  "releaseYear": 2021
}

### 4a. Помилка 400: неправильний тип при оновленні
PATCH {{baseUrl}}/films/{{createFilm.response.body.id}}
Content-Type: application/json

{
  "durationMinutes": "довго"
}

### 4b. Помилка 404: оновлення неіснуючого фільму
PATCH {{baseUrl}}/films/00000000-0000-4000-8000-000000000000
Content-Type: application/json

{
  "releaseYear": 2021
}
### 5. Створити зал (3 ряди × 5 місць = 15 місць)
# @name createHall
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Червона зала",
  "rows": 3,
  "seatsPerRow": 5
}

### 5a. Помилка 409: зал з такою назвою вже існує
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Червона зала",
  "rows": 2,
  "seatsPerRow": 2
}

### 5b. Помилка 400: відсутнє поле
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Без розмірів"
}

### 5c. Помилка 400: неправильний тип поля
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Рядки",
  "rows": "три",
  "seatsPerRow": 5
}

### 5d. Помилка 400: rows не є додатним цілим
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Нульова зала",
  "rows": 0,
  "seatsPerRow": 5
}

### 6. Отримати всі зали
GET {{baseUrl}}/halls

### 7. Отримати зал з переліком місць (15 елементів)
GET {{baseUrl}}/halls/{{createHall.response.body.id}}

### 7a. Помилка 404: залу не існує
GET {{baseUrl}}/halls/00000000-0000-4000-8000-000000000000

### 8. Створити сеанс
# @name createShowing
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2027-01-15T18:30:00.000Z",
  "price": 12500
}

### 8a. Помилка 400: відсутнє поле
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2027-01-15T18:30:00.000Z"
}

### 8b. Помилка 400: неіснуючий фільм
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "00000000-0000-4000-8000-000000000000",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2027-01-15T18:30:00.000Z",
  "price": 12500
}

### 8c. Помилка 400: неіснуючий зал
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "00000000-0000-4000-8000-000000000000",
  "startsAt": "2027-01-15T18:30:00.000Z",
  "price": 12500
}

### 8d. Помилка 400: дата у минулому
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2020-01-15T18:30:00.000Z",
  "price": 12500
}

### 8e. Помилка 400: неіснуюча дата (30 лютого)
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2027-02-30T10:00:00.000Z",
  "price": 12500
}

### 8f. Помилка 400: некоректна дата (не ISO 8601)
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "15.01.2027 18:30",
  "price": 12500
}

### 8g. Помилка 400: ціна не є додатним цілим
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{createFilm.response.body.id}}",
  "hallId": "{{createHall.response.body.id}}",
  "startsAt": "2027-01-15T18:30:00.000Z",
  "price": 0
}
### 9. Отримати всі сеанси (з назвами, відсортовані за часом)
GET {{baseUrl}}/showings

### 10. Фільтрація за фільмом
GET {{baseUrl}}/showings?filmId={{createFilm.response.body.id}}

### 11. Фільтрація за датою
GET {{baseUrl}}/showings?date=2027-01-15

### 12. Фільтрація одночасно за filmId і date
GET {{baseUrl}}/showings?filmId={{createFilm.response.body.id}}&date=2027-01-15

### 12a. Помилка 400: неправильний формат date
GET {{baseUrl}}/showings?date=2027/01/15

### 12b. Помилка 400: неіснуюча дата
GET {{baseUrl}}/showings?date=2027-13-45

### 12c. Помилка 400: filmId не є UUID
GET {{baseUrl}}/showings?filmId=42

### 13. Отримати сеанс за id
GET {{baseUrl}}/showings/{{createShowing.response.body.id}}

### 13a. Помилка 404: сеансу не існує
GET {{baseUrl}}/showings/00000000-0000-4000-8000-000000000000

### 14. Перелік місць сеансу з ознакою зайнятості
GET {{baseUrl}}/showings/{{createShowing.response.body.id}}/seats

### 14a. Помилка 404: місця неіснуючого сеансу
GET {{baseUrl}}/showings/00000000-0000-4000-8000-000000000000/seats

### 15. Забронювати два місця
# @name createBooking
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 1 },
    { "row": 1, "seat": 2 }
  ]
}

### 15a. Помилка 400: порожній масив місць
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": []
}

### 15b. Помилка 400: місце без row або seat
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 2 },
    { "row": 2, "seat": 3 }
  ]
}

### 15c. Помилка 400: місце повторюється у запиті
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 2, "seat": 1 },
    { "row": 2, "seat": 1 }
  ]
}

### 15d. Помилка 400: місця немає в залі
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [{ "row": 9, "seat": 1 }]
}

### 15e. Помилка 409: місце вже заброньоване
POST {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings
Content-Type: application/json

{
  "seats": [
    { "row": 1, "seat": 2 },
    { "row": 3, "seat": 3 }
  ]
}

### 15f. Помилка 404: бронювання для неіснуючого сеансу
POST {{baseUrl}}/showings/00000000-0000-4000-8000-000000000000/bookings
Content-Type: application/json

{
  "seats": [{ "row": 1, "seat": 1 }]
}
### 16. Бронювання конкретного сеансу
GET {{baseUrl}}/showings/{{createShowing.response.body.id}}/bookings

### 16a. Помилка 404: сеансу не існує
GET {{baseUrl}}/showings/00000000-0000-4000-8000-000000000000/bookings

### 17. Усі бронювання
GET {{baseUrl}}/bookings

### 18. Помилка 409: видалення фільму, який використовується в сеансах
DELETE {{baseUrl}}/films/{{createFilm.response.body.id}}

### 19. Помилка 409: видалення залу, який використовується в сеансах
DELETE {{baseUrl}}/halls/{{createHall.response.body.id}}

### 20. Скасувати бронювання (місця звільняються)
DELETE {{baseUrl}}/bookings/{{createBooking.response.body.id}}

### 20a. Помилка 404: бронювання не існує
DELETE {{baseUrl}}/bookings/00000000-0000-4000-8000-000000000000

### 21. Перевірка: місця знову вільні
GET {{baseUrl}}/showings/{{createShowing.response.body.id}}/seats

### 22. Перевірка: бронювань більше немає
GET {{baseUrl}}/bookings

### 23. Успішне видалення фільму без сеансів
# @name freeFilm
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Тимчасовий фільм",
  "durationMinutes": 90,
  "releaseYear": 2020
}

### 23a. DELETE /films/:id → 204
DELETE {{baseUrl}}/films/{{freeFilm.response.body.id}}

### 23b. Помилка 404: повторне видалення того ж фільму
DELETE {{baseUrl}}/films/{{freeFilm.response.body.id}}

### 24. Успішне видалення залу без сеансів
# @name freeHall
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Тимчасова зала",
  "rows": 1,
  "seatsPerRow": 2
}

### 24a. DELETE /halls/:id → 204
DELETE {{baseUrl}}/halls/{{freeHall.response.body.id}}

### 24b. Помилка 404: повторне видалення того ж залу
DELETE {{baseUrl}}/halls/{{freeHall.response.body.id}}

### 25. Swagger-документація
GET {{baseUrl}}/docs
